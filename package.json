{
  "name": "got-otus-o",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "npm run barrels && swc src --out-dir dist -s  --strip-leading-paths",
    "barrels": "barrels",
    "start": "npm run barrels && nodemon src/index.ts",
    "start:prod": "cross-env NODE_ENV=production node --import @swc-node/register/esm-register src/index.js",
    "test": "npm run test:lint",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:generate": "npx prisma generate",
    "test:lint": "eslint",
    "test:lint:fix": "eslint --fix",
    "prettier": "prettier '**/*.{json,md,yml,yaml}' --write",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@swc-node/register": "^1.10.10",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.3",
    "@swc/helpers": "^0.5.17",
    "@tsed/ajv": "^8.14.1",
    "@tsed/barrels": "^6.6.0",
    "@tsed/core": "^8.14.1",
    "@tsed/di": "^8.14.1",
    "@tsed/engines": "^8.14.1",
    "@tsed/exceptions": "^8.14.1",
    "@tsed/json-mapper": "^8.14.1",
    "@tsed/logger": "^7.0.2",
    "@tsed/openspec": "^8.14.1",
    "@tsed/passport": "^8.14.1",
    "@tsed/platform-cache": "^8.14.1",
    "@tsed/platform-exceptions": "^8.14.1",
    "@tsed/platform-express": "^8.14.1",
    "@tsed/platform-http": "^8.14.1",
    "@tsed/platform-log-request": "^8.14.1",
    "@tsed/platform-middlewares": "^8.14.1",
    "@tsed/platform-multer": "^8.14.1",
    "@tsed/platform-params": "^8.14.1",
    "@tsed/platform-response-filter": "^8.14.1",
    "@tsed/platform-views": "^8.14.1",
    "@tsed/prisma": "^8.14.1",
    "@tsed/schema": "^8.14.1",
    "ajv": "^8.17.1",
    "body-parser": "^2.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "dotenv-expand": "^12.0.2",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",
    "method-override": "^3.0.0",
    "passport": "^0.7.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@tsed/cli-plugin-eslint": "6.6.0",
    "@tsed/cli-plugin-passport": "6.6.0",
    "@tsed/cli-plugin-prisma": "6.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/method-override": "^3.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/passport": "^1.0.17",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "tslib": "^2.8.1"
  },
  "tsed": {
    "convention": "conv_default",
    "architecture": "arc_default",
    "packageManager": "npm",
    "runtime": "node"
  },
  "type": "module"
}
